# Local: deixe DATABASE_URL vazio para usar SQLite local.
# Produção Cloud Run: use a URI Session Pooler do Supabase.
DATABASE_URL=

APP_ENV=development

LOKAFEST_ADMIN_USUARIO=admin
LOKAFEST_ADMIN_SENHA=troque-por-uma-senha-forte
LOKAFEST_SESSION_KEY=troque-por-uma-chave-aleatoria-longa

ORGANIZA_API_URL=https://www.humiat.com.br/api/integracoes/lokafest/cliente
ORGANIZA_API_TOKEN=
# Base pública usada somente para logos/empresas parceiras da Home.
ORGANIZA_PUBLIC_BASE_URL=https://www.humiat.com.br

TEMPO_ACEITE_SEGUNDOS=120

# Humiat ID / SSO
HUMIAT_SSO_SECRET=
HUMIAT_SSO_VALIDATE_URL=https://www.humiat.com.br/api/humiat/sso/validar
HUMIAT_PORTAL_URL=https://www.humiat.com.br/painel
# Link oficial do grupo de locadores. Se vazio, o painel mostra o status sem botão de entrada.
LOKAFEST_GRUPO_WHATSAPP_URL=
LOKAFEST_PUBLIC_URL=https://lokafest.com.br
